# EXP 3: read/write mix. Fixed: 4 KiB random, effective QD16 (psync, numjobs=16), direct=1, whole 32 GiB range.
# Varied: read share MIXREAD = 100|70|50|0 (100 and 0 are run as randread / randwrite). Read and write latency reported separately.
[global]
filename=${TESTFILE}
direct=1
ioengine=${ENGINE}
thread=1
group_reporting=1
bs=${BS}
rw=${RW}
numjobs=${NUMJOBS}
iodepth=${IODEPTH}
size=${JOBSIZE}
offset=0
offset_increment=${OFFINC}
time_based=1
runtime=${RUNTIME}
ramp_time=${RAMP}
randrepeat=0
norandommap=1
refill_buffers=1
buffer_compress_percentage=0
lat_percentiles=1
percentile_list=50:90:95:99:99.9:99.99
rwmixread=${MIXREAD}
[job]
