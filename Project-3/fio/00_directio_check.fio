# DIRECT-I/O CHECK: same QD1 4 KiB random read, same 1 GiB range of the test file,
# run once with direct=1 and once with direct=0 (DIRECT env). If direct=1 looks cache-like, STOP.
# Fixed: psync, bs=4k, range 1 GiB, 20 s + 5 s ramp. Varied: DIRECT (1 or 0).
[global]
filename=${TESTFILE}
direct=${DIRECT}
ioengine=psync
thread=1
bs=4k
rw=randread
size=1g
offset=0
randrepeat=0
norandommap=1
time_based=1
runtime=20
ramp_time=5
lat_percentiles=1
percentile_list=50:90:95:99:99.9:99.99

[chk]
