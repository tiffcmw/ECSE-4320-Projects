# EXP 5: tail latency. Fixed: 4 KiB random read, direct=1, whole 32 GiB range, 60 s + 5 s ramp, 3 trials.
# Varied: QD (mid = 4 psync jobs; knee = from Exp 4 per knee rule, engine and thread mode as found there); THREAD env. p50..p99.99 from lat_ns percentiles.
[global]
filename=${TESTFILE}
direct=1
ioengine=${ENGINE}
thread=${THREAD}
group_reporting=1
bs=${BS}
rw=${RW}
numjobs=${NUMJOBS}
iodepth=${IODEPTH}
size=${JOBSIZE}
offset=0
offset_increment=${OFFINC}
time_based=1
runtime=${RUNTIME}
ramp_time=${RAMP}
randrepeat=0
norandommap=1
refill_buffers=1
buffer_compress_percentage=0
lat_percentiles=1
percentile_list=50:90:95:99:99.9:99.99

[job]
