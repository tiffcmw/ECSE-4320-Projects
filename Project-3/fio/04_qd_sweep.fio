# EXP 4: queue-depth sweep. Fixed: 4 KiB random read, direct=1, whole 32 GiB range, 20 s + 3 s ramp.
# Varied: effective QD, built two ways (macOS 27.0.1 limits, see README):
#   psync, thread=1, numjobs=QD, iodepth=1 (QD 1..16; fio allows ~16 jobs because kern.sysv.shmall is 4 MB system wide)
#   posixaio, thread=1, numjobs=1, iodepth=QD (QD 1..256; kern.aioprocmax=256)
# The Little's-law check (IOPS x mean latency) tests whether the configured depth is the depth actually achieved.
[global]
filename=${TESTFILE}
direct=1
ioengine=${ENGINE}
thread=${THREAD}
group_reporting=1
bs=${BS}
rw=${RW}
numjobs=${NUMJOBS}
iodepth=${IODEPTH}
size=${JOBSIZE}
offset=0
offset_increment=${OFFINC}
time_based=1
runtime=${RUNTIME}
ramp_time=${RAMP}
randrepeat=0
norandommap=1
refill_buffers=1
buffer_compress_percentage=0
lat_percentiles=1
percentile_list=50:90:95:99:99.9:99.99

[job]
