# ENGINE CHECK (not an experiment): does iodepth actually produce that many outstanding IOs on macOS?
# Uses a small 1 GiB file (scratch.noindex/engine_check.bin), 4 KiB random read, direct=1.
# Varied by env: ENGINE (psync|posixaio), IODEPTH, NUMJOBS. Fixed: everything else.
# Check: JSON iodepth_level (fio's own queue-depth histogram) and Little's law IOPS x mean latency.
[global]
filename=${CHECKFILE}
direct=1
ioengine=${ENGINE}
bs=4k
rw=randread
iodepth=${IODEPTH}
numjobs=${NUMJOBS}
thread=1
group_reporting=1
randrepeat=0
norandommap=1
time_based=1
runtime=5
ramp_time=1
lat_percentiles=1
refill_buffers=1
buffer_compress_percentage=0
size=1g

[check]
